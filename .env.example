# The Professor - Environment Variables

# ===========================================
# REQUIRED - Core Services
# ===========================================

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Default AI Provider (Required)
GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# OPTIONAL - Multi-Provider AI (Free Tiers!)
# ===========================================

# Cerebras - Best for Real-time Tutoring (1M tokens/day FREE)
# Sign up: https://cloud.cerebras.ai/
# Model: llama3.1-70b (Fastest inference)
CEREBRAS_API_KEY=

# SambaNova - Best for Complex Logic (FREE Unlimited Beta)
# Sign up: https://cloud.sambanova.ai/
# Model: Meta-Llama-3.1-405B-Instruct (Largest model)
SAMBANOVA_API_KEY=

# Groq - Best for Summarization (Generous FREE limits)
# Sign up: https://console.groq.com/
# Model: llama-3.3-70b-versatile (Fast + Smart)
GROQ_API_KEY=

# SiliconFlow - Best for Coding/Math (High FREE daily tier)
# Sign up: https://siliconflow.cn/
# Model: DeepSeek-V3 (Beats GPT-4 on math/code)
SILICONFLOW_API_KEY=

# ===========================================
# FUTURE - Vision & Specialized
# ===========================================

# Hugging Face - OCR & Text Extraction
# HF_API_KEY=

# OpenRouter - Access to Qwen2-VL for handwriting analysis
# OPENROUTER_API_KEY=
