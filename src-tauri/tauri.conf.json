{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Professor",
  "version": "0.1.0",
  "identifier": "com.theprofessor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "The Professor",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "theprofessor"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "theprofessor"
          ]
        }
      ]
    },
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "The Professor Academy",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
